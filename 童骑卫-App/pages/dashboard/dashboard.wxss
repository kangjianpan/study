.hero {
  background: #111820;
  color: #ffffff;
}

.hero .muted {
  color: #9aa7b4;
}

.speed {
  font-size: 132rpx;
  font-weight: 700;
  line-height: 1.1;
  margin: 12rpx 0 20rpx;
}

.unit {
  font-size: 32rpx;
  font-weight: 400;
  color: #9aa7b4;
  margin-left: 12rpx;
}

.bar {
  height: 14rpx;
  background: #26323d;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.bar-fill {
  height: 100%;
  background: #12805c;
  border-radius: 999rpx;
  transition: width 0.12s linear;
}

.wear {
  display: flex;
  gap: 16rpx;
}

.chip {
  flex: 1;
  border-radius: 14rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.chip.ok {
  background: #e3f6ee;
}

.chip.bad {
  background: #fdeaea;
}

.chiptxt {
  font-size: 24rpx;
  color: #6b7785;
}

.chipval {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.chip.ok .chipval {
  color: #12805c;
}

.chip.bad .chipval {
  color: #c62828;
}

.fault {
  justify-content: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
  color: #c62828;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c62828;
}
