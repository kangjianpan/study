.devname {
  font-size: 34rpx;
  font-weight: 600;
  margin: 8rpx 0;
}

.info {
  word-break: break-all;
  margin-bottom: 8rpx;
}

.did {
  margin-top: 6rpx;
  font-size: 22rpx;
  word-break: break-all;
}

.dev {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef1f4;
}

.dev:last-child {
  border-bottom: none;
}

.empty {
  padding: 24rpx 0;
}

.tip {
  padding-top: 20rpx;
}

.err {
  color: #c62828;
  line-height: 1.6;
}

.note .muted {
  line-height: 1.8;
}
