<view class="wrap">

  <view class="card">
    <view class="row">
      <view class="card-title">车端网关</view>
      <view class="pill {{connected ? 'pill-ok' : 'pill-idle'}}">
        {{connected ? '已连接' : '未连接'}}
      </view>
    </view>

    <block wx:if="{{connected}}">
      <view class="devname">{{deviceName}}</view>
      <view class="muted info">{{info || '（未读到设备信息）'}}</view>
      <view class="btn btn-ghost gap-top" bindtap="disconnect">断开连接</view>
      <view class="btn btn-primary gap-top" bindtap="goDashboard">进入仪表</view>
    </block>

    <block wx:else>
      <view class="muted">
        打开车上的电源，等指示灯常亮后再扫描。
      </view>
      <view class="btn btn-primary gap-top" bindtap="toggleScan">
        {{scanning ? '停止扫描' : '扫描附近车辆'}}
      </view>
    </block>
  </view>

  <view class="card" wx:if="{{error}}">
    <view class="err">{{error}}</view>
  </view>

  <view class="card" wx:if="{{scanning || devices.length}}">
    <view class="card-title">扫描结果</view>

    <view class="empty muted" wx:if="{{devices.length === 0}}">
      扫描中…
    </view>

    <view
      class="dev"
      wx:for="{{devices}}"
      wx:key="deviceId"
      data-id="{{item.deviceId}}"
      data-name="{{item.name}}"
      bindtap="tapDevice"
    >
      <view class="row">
        <view class="devname">{{item.name}}</view>
        <view class="muted num">{{item.rssi}} dBm</view>
      </view>
      <view class="muted num did">{{item.deviceId}}</view>
    </view>

    <view class="muted tip" wx:if="{{connecting}}">连接中…</view>
  </view>

  <view class="card note">
    <view class="card-title">没有看到设备？</view>
    <view class="muted">1. 开发者工具模拟器不支持蓝牙，请用真机预览。</view>
    <view class="muted">2. 手机系统蓝牙打开，安卓需允许微信使用「附近设备」。</view>
    <view class="muted">3. 网关已连上另一台手机时不会再广播，让那台先断开。</view>
  </view>

</view>
