.banner {
  background: #111820;
  color: #ffffff;
}

.bannertitle {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.bannertext {
  font-size: 26rpx;
  line-height: 1.7;
  color: #b7c3ce;
}

.kv {
  margin-bottom: 12rpx;
}

.k {
  font-size: 22rpx;
  color: #8a94a6;
}

.v {
  font-size: 24rpx;
  word-break: break-all;
  color: #1b2530;
}

.status {
  margin-top: 12rpx;
  word-break: break-all;
}

.err {
  margin-top: 12rpx;
  color: #c62828;
  line-height: 1.6;
}

.item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3f5;
}

.item:last-of-type {
  border-bottom: none;
}

.raw {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f5f7f9;
  border-radius: 12rpx;
  font-size: 22rpx;
  word-break: break-all;
  color: #6b7785;
}

.card .muted {
  line-height: 1.8;
}
