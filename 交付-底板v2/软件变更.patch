+    {
+        /* 等新写入的重装值被硬件接受 */
+    }
+    IWDG->KR = 0xAAAAu;                 /* 先装载一次计数器 */
+    IWDG->KR = 0xCCCCu;                 /* 启动，之后再也关不掉 */
