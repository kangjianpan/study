+ * g_mtx_cfg      普通互斥量 —— 保护下面的 s_limit
+ * g_mtx_uart_log 普通互斥量 —— 保护 USART1 上的 printf
+ *
+ * 全部初始化为 NULL。app_start() 创建后若仍为 NULL 就进入死循环，
+ * 等 200 ms 看门狗复位 —— 那种状态下跑下去比不跑更危险。 */
+QueueHandle_t      g_q_sensor = NULL;
+QueueHandle_t      g_q_log = NULL;
+EventGroupHandle_t g_eg_fault = NULL;
+SemaphoreHandle_t  g_mtx_i2c = NULL;
+SemaphoreHandle_t  g_mtx_cfg = NULL;
+SemaphoreHandle_t  g_mtx_uart_log = NULL;
+
+/* CommTask 句柄，唯一目的：让串口接收中断能直接把它叫醒，见 app_main.h。 */
+TaskHandle_t       g_comm_task_handle = NULL;
+
+/* 链路活性。g_last_link_tick 由 CommTask 每收到一帧刷新一次，
+ * g_link_seen 一旦置 1 就永不清零（表示"这辆车见过了手机"）。
+ * SafetyTask 靠这两个判断"连上过但后来断了"这种真正的失联。 */
+volatile uint32_t g_last_link_tick = 0u;
+volatile uint8_t  g_link_seen = 0u;
+
+/* 安全任务本拍的结论：允许驱动为 1。上电初值 0 —— 在 SafetyTask
+ * 跑完第一拍之前，任何人都不能动手，这是最保守的默认。 */
+volatile uint8_t  g_drive_allowed = 0u;
+volatile uint32_t g_control_tick = 0u;
+volatile uint32_t g_local_faults = 0u;
+
+/* 台架调试覆盖量，只能由协议命令 CMD_SET_THROTTLE / CMD_SET_SPEED /
+ * CMD_DEBUG_INTERLOCK 改写。初值是有讲究的：
+ *   g_dbg_throttle = -1  表示"不覆盖"，跟随真实踏板；
+ *   g_dbg_speed_x100 = 0 表示"不覆盖"（霍尔尚未接入，实际等价于车速为 0）；
+ *   g_dbg_interlock_fail = 0 表示不伪造联锁故障。 */
+volatile int16_t  g_dbg_throttle = -1;
+volatile uint16_t g_dbg_speed_x100 = 0u;
+volatile uint8_t  g_dbg_interlock_fail = 0u;
+
+/* 限速权限，只通过下面的那几个存取函数访问 ——
+ * 因为它是多任务共享的，直接读写会被另一个任务打断。
+ * 四个来源取最小值才是最终生效的限速：
+ *   venue   场地硬上限，由场馆那侧下发
+ *   parent  家长设定
+ *   child   孩子端自己选的，只能往下调
+ *   fallback 链路断开时临时压上来的值，链路恢复后清零
+ * 加进来一个新来源时，记得同步去改 calc_effective()。 */
+static limit_cfg_t s_limit;
+
+/* 限速权限的读写接口 */
+static uint8_t calc_effective(const limit_cfg_t *l)
+{
+    uint8_t m = l->venue;
+
+    if (l->parent < m)
+    {
+        m = l->parent;
+    }
+    if (l->child < m)
+    {
+        m = l->child;
+    }
+    if ((l->fallback > 0u) && (l->fallback < m))
+    {
+        m = l->fallback;
+    }
+
+    return m;
+}
+
+void App_SetLimit(uint8_t source, uint8_t kmh)
+{
+    if (xSemaphoreTake(g_mtx_cfg, pdMS_TO_TICKS(5)) != pdTRUE)
+    {
+        return;
+    }
+
+    switch (source)
+    {
+    case LIMIT_SRC_VENUE:
+        s_limit.venue = kmh;
+        break;
+    case LIMIT_SRC_PARENT:
+        s_limit.parent = kmh;
+        break;
+    case LIMIT_SRC_CHILD:
+        /* 孩子端只能往低里调，不许把上限抬高 */
+        if (kmh < s_limit.child)
+        {
+            s_limit.child = kmh;
+        }
+        break;
+    default:
+        break;
+    }
+
+    s_limit.effective = calc_effective(&s_limit);
+
+    (void)xSemaphoreGive(g_mtx_cfg);
+
+    App_LogEvent(LOG_EVT_LIMIT_CHANGE,
+                 (uint16_t)((source << 8) | s_limit.effective));
+}
+
+/* 只在链路状态发生变化时由 SafetyTask 调用。传入 0 表示撤销降级。 */
+void App_SetLinkFallback(uint8_t kmh)
+{
+    uint8_t changed;
+
+    if (xSemaphoreTake(g_mtx_cfg, pdMS_TO_TICKS(5)) != pdTRUE)
+    {
+        return;
+    }
+
+    changed = (s_limit.fallback != kmh) ? 1u : 0u;
+    s_limit.fallback = kmh;
+    s_limit.effective = calc_effective(&s_limit);
+
+    (void)xSemaphoreGive(g_mtx_cfg);
+
+    if (changed != 0u)
+    {
+        App_LogEvent(LOG_EVT_LIMIT_CHANGE,
+                     (uint16_t)((LIMIT_SRC_LINK << 8) | s_limit.effective));
+    }
+}
+
+void App_GetLimitSnapshot(limit_cfg_t *out)
+{
+    if (xSemaphoreTake(g_mtx_cfg, pdMS_TO_TICKS(5)) != pdTRUE)
+    {
+        out->venue = 0u;
+        out->parent = 0u;
+        out->child = 0u;
+        out->fallback = 0u;
+        out->effective = 0u;
+        return; /* Fail closed rather than leave an uninitialized/old limit. */
+    }
+
+    *out = s_limit;
+
+    (void)xSemaphoreGive(g_mtx_cfg);
+}
+
+/* 创建 7 个任务
+ *
+ * 优先级从高到低：safety(6) > control(5) > sensor(4) > comm(3)
+ *               > telemetry(2) = hmi(2) > log(1)
+ * telemetry 和 hmi 同优先级，靠时间片轮转，谁都不会饿死。
+ * 只有 comm 需要保存句柄，因为串口中断要直接唤醒它。 */
+static void create_tasks(void)
+{
+    /* 10 ms 扫一遍故障、跑状态机、喂狗。最高优先级，谁也别想挡它。 */
+    xTaskCreate(SafetyTask,  "safety",  STK_SAFETY,  NULL, PRIO_SAFETY,  NULL);
+    /* 5 ms 一次，把踏板/限速/避障/斜率算完丢给电调。 */
+    xTaskCreate(ControlTask, "control", STK_CONTROL, NULL, PRIO_CONTROL, NULL);
+    /* 10 ms 采一次 IMU/ADC，30 ms 采 ToF，50 ms 采 NFC。 */
+    xTaskCreate(SensorTask,  "sensor",  STK_SENSOR,  NULL, PRIO_SENSOR,  NULL);
+    /* 收帧、拆帧、执行命令。无数据时被通知阻塞，不占 CPU。 */
+    xTaskCreate(CommTask,    "comm",    STK_COMM,    NULL, PRIO_COMM,    &g_comm_task_handle);
+    /* 100 ms 一帧遥测，每 1 s 一帧心跳。走 USART3 给 ESP32。 */
+    xTaskCreate(TelemetryTask,   "cloud",   STK_TELEMETRY,   NULL, PRIO_TELEMETRY,   NULL);
+    /* 33 ms 一次：状态灯闪烁 + 每秒一行调试打印。 */
+    xTaskCreate(HmiTask,     "hmi",     STK_HMI,     NULL, PRIO_HMI,     NULL);
+    /* 最低优先级：从日志队列里取事件、存黑匣子、打印。
+     * 只有别的任务都闲着它才能跑，绝不会拖慢控制回路。 */
+    xTaskCreate(LogTask,     "log",     STK_LOG,     NULL, PRIO_LOG,     NULL);
+}
+
+/* FreeRTOS 钩子函数
+ *
+ * 两个都是先打一行 ASCII 标记，然后彻底停住。
+ * 停在这里是故意的：SafetyTask 从此不会再喂狗，
+ * 200 ms 后硬件看门狗复位，而不是让卡丁车在没人管的情况下继续跑。
+ * （IWDG 靠 LSI 独立计数，中断全关也拦不住它。） */
+void vApplicationStackOverflowHook(TaskHandle_t xTask, char *pcTaskName)
+{
+    (void)xTask;
+
+    /* configCHECK_FOR_STACK_OVERFLOW == 2 时内核会把任务名带过来，
+     * 这里的判空只是防御性写法。
+     * 注意本函数是在上下文切换里被调用的（异常上下文），
+     * 打印走的是阻塞式轮询串口，会有毫秒级延迟，只因为反正是要死了才容忍。 */
+    printf("\r\nFATAL: stack overflow in %s\r\n",
+           (pcTaskName != NULL) ? pcTaskName : "?");
+
+    taskDISABLE_INTERRUPTS();
+    for (;;)
+    {
+    }
+}
+
+void vApplicationMallocFailedHook(void)
+{
+    printf("\r\nFATAL: heap exhausted\r\n");
+
+    taskDISABLE_INTERRUPTS();
+    for (;;)
+    {
+    }
+}
+
+/* 应用入口 */
+void app_start(void)
+{
+    sensor_data_t zero;     /* 占位样本，清零后先塞进队列 */
+    uint8_t       reason;   /* Bsp_GetResetReason() 的返回值，只用于开机横幅 */
+
+    memset(&zero, 0, sizeof(zero));
+
+    /* 六个内核对象的创建。参数在这里能一眼看出"多大、装什么"：
+     * 传感器队列深度 1（只要最新值），日志队列深度 8（能扛一小段突发）。
+     * 三个信号量都建成互斥量而不是二值信号量：
+     * 互斥量带优先级继承，持锁的低优先级任务被抢占时不会把高优先级任务拖住。 */
+    g_q_sensor     = xQueueCreate(1, sizeof(sensor_data_t));
+    g_q_log        = xQueueCreate(8, sizeof(log_event_t));
+    g_eg_fault     = xEventGroupCreate();
+    g_mtx_i2c      = xSemaphoreCreateMutex();
+    g_mtx_cfg      = xSemaphoreCreateMutex();
+    g_mtx_uart_log = xSemaphoreCreateMutex();
+
+    /* 注意：堆真不够时，pvPortMalloc 内部会先调 vApplicationMallocFailedHook()，
+     * 在那里死循环并被看门狗复位，所以下面这条分支其实走不到。
+     * 留着是为了将来万一关掉 configUSE_MALLOC_FAILED_HOOK 还能兜底。 */
+    if ((g_q_sensor == NULL) || (g_q_log == NULL) || (g_eg_fault == NULL) ||
+        (g_mtx_i2c == NULL) || (g_mtx_cfg == NULL) || (g_mtx_uart_log == NULL))
+    {
+        printf("FATAL: RTOS object creation failed\r\n");
+        for (;;)
+        {
+        }
+    }
+
+    /* 先塞一份全零样本，免得消费者 Peek 到一个空队列 */
+    (void)xQueueOverwrite(g_q_sensor, &zero);
+
+    s_limit.venue     = LIMIT_VENUE_DEFAULT;
+    s_limit.parent    = LIMIT_PARENT_DEFAULT;
+    s_limit.child     = LIMIT_CHILD_DEFAULT;
+    s_limit.effective = calc_effective(&s_limit);
+
+    /* 读一下复位来源，好区分"被看门狗拉回来的"和"正常上电" */
+    reason = Bsp_GetResetReason();
+
+    printf("\r\n");
+    printf("============================================\r\n");
+    printf(" GuardKart %s\r\n", APP_VERSION_STR);
+    if (reason == RESET_IWDG)
+    {
+        printf(" RESET: watchdog - supervisor intervened\r\n");
+    }
+    else if (reason == RESET_PIN)
+    {
+        printf(" RESET: power-on / reset pin\r\n");
+    }
+    else
+    {
+        printf(" RESET: unknown\r\n");
+    }
+#if APP_BRINGUP_MODE
+    printf(" INTERLOCK: bypassed (bring-up mode)\r\n");
+#else
+    printf(" INTERLOCK: enforced\r\n");
+#endif
+    printf(" limit: venue=%u parent=%u child=%u -> %u km/h\r\n",
+           (unsigned)s_limit.venue, (unsigned)s_limit.parent,
+           (unsigned)s_limit.child, (unsigned)s_limit.effective);
+    printf("============================================\r\n");
+
+    Bsp_ClearResetFlags();
+
+    Comm_RxInit();
+
+    create_tasks();
+
+    printf(" heap free after tasks: %u bytes\r\n",
+           (unsigned)xPortGetFreeHeapSize());
+    printf(" starting scheduler\r\n");
+
+    vTaskStartScheduler();
+
+    /* 只有堆内存不够、调度器起不来时才会走到这里 */
+    printf("FATAL: scheduler returned\r\n");
+    for (;;)
+    {
+    }
+}
--- a/童骑卫-FW/Core/Src/app_safety.c
+++ b/童骑卫-FW/Core/Src/app_safety.c
@@ -1,384 +1,426 @@
-#include "app_main.h"
-#include "app_config.h"
-#include "app_pins.h"
-#include "app_state.h"
-#include "bsp.h"
-#include "drv_motor.h"
-
-/* SafetyTask：最高优先级，周期 10 ms
- *
- * 职责
- *   1. 每个节拍翻转一次监控心跳（PB13）
- *   2. 逐条评估所有故障条件
- *   3. 跑状态机（文档 7.5）并控制电调使能线
- *   4. 喂看门狗——而且只在完整跑完一圈之后才喂
- *
- * 故障分三类，区别很关键：
- *   HARD  直接进 FAULT_LOCK，立刻切断驱动
- *   SOFT  先进 DECEL：把油门斜坡降下来，一直不消失才切
- *   INFO  只限速，不改状态（丢链路就属于这一类）
- *
- * 高速行驶中直接断驱动本身就是危险动作，
- * 这正是 DECEL 这个状态存在的全部理由。 */
-
-#define FAULT_MASK_HARD (FAULT_ESTOP      | FAULT_ROLLOVER   | FAULT_CRASH     | \
-                         FAULT_OVERCURRENT | FAULT_UNDERVOLT  | FAULT_REMOTE_STOP | \
-                         FAULT_INJECT)
-
-#define FAULT_MASK_SOFT (FAULT_INTERLOCK  | FAULT_OVERSPEED)
-
-/* SafetyTask 的文件级状态
- *
- * 这些变量跨节拍保留，而且只有 SafetyTask 自己读写，所以不加锁、不 volatile。
- * 每个"条件持续一段时间才判定"的故障，都需要一对 (计时中标志, 起始时刻)；
- * 每个"判定后不允许自动恢复"的故障，都需要一个闩锁位。
- *
- * s_hb_level        心跳输出电平，每拍取反，PB13 上看到 50 Hz 方波说明本任务在跑
- * s_roll_timing     倾覆计时器是否正在计时（1 = 上一拍已经超阈值，正在累计）
- * s_roll_start      倾覆计时起点，只在 s_roll_timing 由 0 变 1 时写入
- * s_roll_latched    倾覆已判定，只能复位清除
- * s_crash_latched   碰撞已判定，只能复位清除
- * s_estop_latched   急停已按下，只能复位清除（松开按钮不能自动恢复）
- * s_decel_latched   DECEL 超时已判定，见下方详细说明
- * s_oc_latched      过流已判定，只能复位清除（仅 APP_CHECK_OVERCURRENT=1 时存在）
- * s_published_faults 上一拍推给黑匣子的故障字，用来检测跳变、避免每拍都记一条
- * s_link_lost       上一拍的失联判断结果，只在变化时去改限速，避免反复写 */
-static uint8_t    s_hb_level = 0u;
-static uint8_t    s_roll_timing = 0u;
-static TickType_t s_roll_start = 0u;
-static uint8_t    s_roll_latched = 0u;
-static uint8_t    s_crash_latched = 0u;
-static uint8_t    s_estop_latched = 0u;
-/* DECEL 超时之后置位。没有这一位的话，升级就只是去 FAULT_LOCK 逛一个节拍：
- * 下一拍已经看不到硬故障，又直接掉回 STANDBY，
- * 那条"我们已经不再信任它了"的规则就完全看不出来。
- * 和别的闩锁一样，只能靠复位清除。 */
-static uint8_t    s_decel_latched = 0u;
-#if APP_CHECK_OVERCURRENT
-static uint8_t    s_oc_latched = 0u;
-#endif
-static uint32_t   s_published_faults = 0u;
-static uint8_t    s_link_lost = 0u;
-
-/* 故障评估 */
-static uint32_t evaluate_local_faults(const sensor_data_t *s, const limit_cfg_t *lim)
-{
-    uint32_t faults = 0u;           /* 本拍累积出来的故障位 */
-    uint32_t limit_x100;            /* 当前有效限速，换算成 km/h × 100 */
-    int32_t  ax;                    /* 三轴加速度，单位 mg，先提出来避免重复取 */
-    int32_t  ay;
-    int32_t  az;
-    uint32_t mag2;                  /* 加速度模的平方，单位 (mg)^2，比平方省一次开方 */
-
-    /* 急停，低电平有效。做成了闩锁：文档规定物理急停不能靠软件恢复，
-     * 所以松开按钮本身不应该把车重新武装起来。 */
-    if (HAL_GPIO_ReadPin(ESTOP_GPIO_Port, ESTOP_Pin) == GPIO_PIN_RESET)
-    {
-        s_estop_latched = 1u;
-    }
-    if (s_estop_latched != 0u)
-    {
-        faults |= FAULT_ESTOP;
-    }
-
-    /* 佩戴联锁。bring-up 模式下传感器还没装，
-     * 所以这一位只能由调试覆盖命令（CMD_DEBUG_INTERLOCK）造出来。 */
-#if !APP_BRINGUP_MODE
-    if ((s->seat_pressed == 0u) || (s->belt_closed == 0u) || (s->helmet_ok == 0u))
-    {
-        faults |= FAULT_INTERLOCK;
-    }
-#endif
-
-    /* 倾覆：|ay| 超过 sin(45°) 并持续 ROLL_TIME_MS */
-    if (s->imu_present != 0u)
-    {
-        if ((s->accel_mg[1] > 7000) || (s->accel_mg[1] < -7000))
-        {
-            if (s_roll_timing == 0u)
-            {
-                s_roll_timing = 1u;
-                s_roll_start = xTaskGetTickCount();
-            }
-            else if ((xTaskGetTickCount() - s_roll_start) >=
-                     pdMS_TO_TICKS(ROLL_TIME_MS))
-            {
-                s_roll_latched = 1u;
-            }
-        }
-        else
-        {
-            s_roll_timing = 0u;
-        }
-    }
-    if (s_roll_latched != 0u)
-    {
-        faults |= FAULT_ROLLOVER;
-    }
-
-    /* 碰撞：|a|^2 明显超过 1 g，不开根号，直接比平方 */
-    if (s->imu_present != 0u)
-    {
-        ax = (int32_t)s->accel_mg[0];
-        ay = (int32_t)s->accel_mg[1];
-        az = (int32_t)s->accel_mg[2];
-        mag2 = (uint32_t)(ax * ax) + (uint32_t)(ay * ay) + (uint32_t)(az * az);
-        if (mag2 > 9000000u)            /* (3000 mg) 的平方 */
-        {
-            s_crash_latched = 1u;
-        }
-    }
-    if (s_crash_latched != 0u)
-    {
-        faults |= FAULT_CRASH;
-    }
-
-    /* 超速。属于 SOFT：车还在动，所以先斜坡降下来。 */
-    limit_x100 = (uint32_t)lim->effective * 100u;
-    if ((limit_x100 > 0u) &&
-        (s->speed_kmh_x100 > (uint16_t)((limit_x100 * OVERSPEED_FACTOR_X100) / 100u)))
-    {
-        faults |= FAULT_OVERSPEED;
-    }
-
-    /* 欠压 */
-#if APP_CHECK_VBUS
-    if ((s->bus_mv > 1000u) && (s->bus_mv < UNDERVOLT_MV))
-    {
-        faults |= FAULT_UNDERVOLT;
-    }
-#endif
-
-    /* 过流，和急停一样做闩锁 */
-#if APP_CHECK_OVERCURRENT
-    if (s->current_ma > OVERCURRENT_MA)
-    {
-        s_oc_latched = 1u;
-    }
-    if (s_oc_latched != 0u)
-    {
-        faults |= FAULT_OVERCURRENT;
-    }
-#endif
-
-    return faults;
-}
-
-/* 状态转移表（文档 7.5）
- *
- * 输入只有 (当前状态, 故障掩码, 油门, 停留时长)，
- * 是个纯函数，所以不用读任务里剩下的代码也能单独推演。 */
-static app_state_t next_state(app_state_t st, uint32_t hard, uint32_t soft,
-                              uint16_t throttle, uint32_t state_ms,
-                              uint8_t latched)
-{
-    app_state_t next = st;
-
-    switch (st)
-    {
-    case APP_STATE_SELF_TEST:
-        if (state_ms >= SELFTEST_MS)
-        {
-            next = (hard != 0u) ? APP_STATE_FAULT_LOCK : APP_STATE_STANDBY;
-        }
-        break;
-
-    case APP_STATE_STANDBY:
-        if (hard != 0u)
-        {
-            next = APP_STATE_FAULT_LOCK;
-        }
-        else if ((soft == 0u) && (throttle < PEDAL_IDLE_THRESHOLD))
-        {
-            /* 必须先松开油门，才允许使能驱动 */
-            next = APP_STATE_READY;
-        }
-        break;
-
-    case APP_STATE_READY:
-        if (hard != 0u)
-        {
-            next = APP_STATE_FAULT_LOCK;
-        }
-        else if (soft != 0u)
-        {
-            next = APP_STATE_DECEL;
-        }
-        else if (throttle > PEDAL_RUN_THRESHOLD)
-        {
-            next = APP_STATE_RUN;
-        }
-        break;
-
-    case APP_STATE_RUN:
-        if (hard != 0u)
-        {
-            next = APP_STATE_FAULT_LOCK;
-        }
-        else if (soft != 0u)
-        {
-            next = APP_STATE_DECEL;
-        }
-        break;
-
-    case APP_STATE_DECEL:
-        /* 3 秒的期限从进入 DECEL 那一刻起算，
-         * 而不是从斜坡降到零那一刻起算：
-         * 降不下来本身就是要升级的故障。 */
-        if (hard != 0u)
-        {
-            next = APP_STATE_FAULT_LOCK;
-        }
-        else if (state_ms >= DECEL_TIMEOUT_MS)
-        {
-            next = APP_STATE_FAULT_LOCK;
-        }
-        else if ((soft == 0u) && (Motor_GetOutput() == 0))
-        {
-            next = APP_STATE_READY;         /* condition cleared, stopped */
-        }
-        break;
-
-    case APP_STATE_FAULT_LOCK:
-    default:
-        /* 只有远程停车和欠压可以不掉电就解除；
-         * 其余闩锁（急停、倾覆、碰撞、过流、DECEL 超时）都会一直让条件成立，
-         * 所以这条边只可能被那两个触发。 */
-        if ((hard == 0u) && (latched == 0u))
-        {
-            next = APP_STATE_STANDBY;
-        }
-        break;
-    }
-
-    return next;
-}
-
-/* 任务主体 */
-void SafetyTask(void *arg)
-{
-    TickType_t    last_wake;    /* vTaskDelayUntil 的基准，保证周期严格 10 ms */
-    TickType_t    state_since;  /* 进入当前状态的时刻，算 DECEL 超时用 */
-    sensor_data_t s;            /* 本拍从 g_q_sensor 取到的传感器快照 */
-    limit_cfg_t   lim;          /* 本拍从 g_mtx_cfg 取到的限速快照 */
-    uint32_t      local;        /* 本任务自己评估出来的故障（急停/倾覆/碰撞/超速…） */
-    uint32_t      remote;       /* 远端命令产生的故障，来自 g_eg_fault 事件组 */
-    uint32_t      all;          /* local | remote，本拍的总故障字 */
-    uint32_t      hard;         /* all 里属于"立刻切断"的那一类 */
-    uint32_t      soft;         /* all 里属于"先降速再切"的那一类 */
-    uint32_t      state_ms;     /* 在当前状态已经停留了多久 */
-    uint16_t      throttle;     /* 本拍采用的油门值，千分比 */
-    uint8_t       link_lost;    /* 本拍的失联判断，和 s_link_lost 比较得出跳变 */
-    uint8_t       enable;       /* 本拍该不该给电调使能 */
-    app_state_t   st;           /* 当前状态 */
-    app_state_t   next;         /* 状态机算出的下一状态 */
-
-    (void)arg;
-
-    last_wake   = xTaskGetTickCount();
-    state_since = last_wake;
-
-    for (;;)
-    {
-        vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(PERIOD_SAFETY_MS));
-
-        /* 心跳，每个节拍翻转一次 */
-        s_hb_level ^= 1u;
-        HAL_GPIO_WritePin(HB_GPIO_Port, HB_Pin,
-                          (s_hb_level != 0u) ? GPIO_PIN_SET : GPIO_PIN_RESET);
-
-        (void)xQueuePeek(g_q_sensor, &s, 0);
-        App_GetLimitSnapshot(&lim);
-
-        /* 油门：调试覆盖优先，规则和 ControlTask 保持一致。 */
-        throttle = (g_dbg_throttle >= 0) ? (uint16_t)g_dbg_throttle
-                                         : s.throttle_permille;
-
-        local  = evaluate_local_faults(&s, &lim);
-        if (g_dbg_interlock_fail != 0u)
-        {
-            local |= FAULT_INTERLOCK;
-        }
-        remote = (uint32_t)xEventGroupGetBits(g_eg_fault) & FAULT_MASK_REMOTE;
-        all    = local | remote;
-
-        /* 链路监护。丢了手机不能把孩子晾在赛道中间，
-         * 所以这里不改状态：只把限速压到 LIMIT_FALLBACK，等链路回来。
-         * 但标志位仍会通过 FAULT_LINK_LOST 传给 HMI 和黑匣子。 */
-        link_lost = 0u;
-        if (g_link_seen != 0u)
-        {
-            if ((xTaskGetTickCount() - g_last_link_tick) >
-                pdMS_TO_TICKS(LINK_TIMEOUT_MS))
-            {
-                link_lost = 1u;
-                all |= FAULT_LINK_LOST;
-            }
-        }
-        if (link_lost != s_link_lost)
-        {
-            s_link_lost = link_lost;
-            App_SetLinkFallback((link_lost != 0u) ? LIMIT_FALLBACK : 0u);
-        }
-
-        /* 故障注入：模拟一个不再调度的控制器。
-         * 中断还开着，但这里永不主动让出，
-         * 而本任务又是最高优先级，所以别的任务再也不会运行。
