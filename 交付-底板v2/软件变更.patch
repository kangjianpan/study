+    IWDG->KR = 0x5555u;                 /* 解锁 PR 和 RLR */
+    IWDG->PR = 0x0000u;                 /* LSI / 4，约 10 kHz */
+    IWDG->RLR = 2000u;                  /* 2000 个计数 -> 200 ms */
